# Copy to .env in this same directory (api-bird-orchestator-microservice/, alongside
# docker-compose.yml) and fill in real values. .env is gitignored — never commit it, print its
# contents, or move it out of this machine.

# --- Postgres ---
POSTGRES_DB=bird_dex
POSTGRES_USER=bird_user
POSTGRES_PASSWORD=bird_password

# --- RabbitMQ ---
RABBITMQ_USER=user
RABBITMQ_PASSWORD=password

# --- AWS S3 (shared bucket, real AWS — no local MinIO in this compose file) ---
AWS_S3_BUCKET_NAME=
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=
AWS_REGION=us-east-1
